# Copy this file to .env and fill in your credentials
# The anon / publishable key is designed to be public (it ships in the browser).
# Never put a service_role key in this file or in any REACT_APP_* variable.

REACT_APP_SUPABASE_URL=https://qlulnldctvcjlzflpupe.supabase.co

# Either the legacy "anon" JWT key (starts with eyJ) or the newer publishable
# key (starts with sb_publishable_) works. Both are safe to expose in a browser.
REACT_APP_SUPABASE_ANON_KEY=

# Public site origin used for Supabase auth redirects (password reset, email
# confirmation). Must also be allow-listed in
# Supabase -> Authentication -> URL Configuration -> Redirect URLs.
REACT_APP_SITE_URL=http://localhost:3000

# How to get the key:
# 1. Go to https://supabase.com/dashboard/project/qlulnldctvcjlzflpupe/settings/api
# 2. Find "Project API keys"
# 3. Copy the "anon" / "publishable" key
# 4. Paste it above
# 5. Restart server (Ctrl+C then npm start)
