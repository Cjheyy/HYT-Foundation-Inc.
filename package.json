{
  "name": "hyt-foundation",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@supabase/supabase-js": "^2.116.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "react-scripts": "5.0.1",
    "react-toastify": "^11.1.0",
    "swiper": "^14.2.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --runInBand",
    "lint": "eslint src",
    "eject": "react-scripts eject"
  },
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^swiper/react$": "<rootDir>/src/__mocks__/swiper-react.jsx",
      "^swiper/modules$": "<rootDir>/src/__mocks__/swiper-modules.jsx",
      "^swiper/css.*$": "<rootDir>/src/__mocks__/swiper-css.js"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "description": "**\"Bringing the Next Generation Forward\"**",
  "main": "index.js",
  "devDependencies": {
    "jest": "^27.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cjheyy/HYT-Foundation-Inc..git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Cjheyy/HYT-Foundation-Inc./issues"
  }
